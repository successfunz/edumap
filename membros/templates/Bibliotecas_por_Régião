        // ============================================
        // 9. FUNÇÕES DE RENDERIZAÇÃO
        // ============================================
        function getFilteredLibraries() {
            return bibliotecas.filter(lib => {
                const matchRegion = currentRegion === "todas" || lib.regiao.toLowerCase().includes(currentRegion.toLowerCase());
                const matchSearch = lib.nome.toLowerCase().includes(currentSearch.toLowerCase()) || 
                                     lib.regiao.toLowerCase().includes(currentSearch.toLowerCase());
                return matchRegion && matchSearch;
            });
        }

        function renderList() {
            librariesList.innerHTML = '';
            const filtered = getFilteredLibraries();
            
            if (filtered.length === 0) {
                librariesList.innerHTML = '<p style="text-align:center; padding: 1rem; color: #64748b;">Nenhuma biblioteca encontrada.</p>';
                return;
            }

            filtered.forEach(lib => {
                const item = document.createElement('div');
                item.className = 'library-item';
                item.onclick = () => showOnMap(lib);
                
                const isSaved = savedLibraries.includes(lib.id);
                
                item.innerHTML = `
                    <div class="lib-icon">${isSaved ? '⭐' : '📚'}</div>
                    <div class="lib-info">
                        <h4>${lib.nome}</h4>
                        <p>${lib.regiao}</p>
                    </div>
                    <span class="status ${lib.status.toLowerCase()}">${lib.status}</span>
                `;
                librariesList.appendChild(item);
            });
        }

        function renderMarkers() {
            markersLayer.clearLayers();
            const filtered = getFilteredLibraries();

            filtered.forEach(lib => {
                const iconColor = lib.status === "Aberta" ? '#3789E8' : '#ef4444';
                const isSaved = savedLibraries.includes(lib.id);
                
                const customIcon = L.divIcon({
                    className: '',
                    html: `<div style="background-color: ${iconColor}; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.3); font-size: ${isSaved ? '12' : '15'}px;">${isSaved ? '⭐' : '📚'}</div>`,
                    iconSize: [30, 30],
                    iconAnchor: [15, 15]
                });

                const marker = L.marker([lib.lat, lib.lng], { icon: customIcon }).addTo(markersLayer);
                
                marker.on('click', () => {
                    showDetails(lib);
                    map.setView([lib.lat, lib.lng], 16);
                });
            });
        }

        function showOnMap(lib) {
            map.setView([lib.lat, lib.lng], 16);
            showDetails(lib);
        }

        // ============================================
        // 10. FUNÇÃO PARA ABRIR O PAINEL
        // ============================================
        function showDetails(lib) {
            currentLib = lib;
            
            let imgUrl = lib.imagem;
            if (!imgUrl) {
                imgUrl = "https://via.placeholder.com/400x250?text=Biblioteca";
            }
            
            document.getElementById('panelHeader').style.backgroundImage = `url('${imgUrl}')`;
            document.getElementById('detailsTitle').textContent = lib.nome;
            document.getElementById('detailsCategory').textContent = `Biblioteca Pública • ${lib.regiao}`;
            document.getElementById('detailsAddress').innerHTML = `<strong>Endereço</strong>${lib.endereco}`;
            
            const statusEl = document.getElementById('detailsStatus');
            statusEl.textContent = lib.status;
            statusEl.className = lib.status === "Aberta" ? "open-status" : "";
            
            document.getElementById('detailsHours').textContent = lib.horario;
            document.getElementById('detailsSite').href = `https://${lib.site}`;
            document.getElementById('detailsSite').textContent = lib.site;
            document.getElementById('detailsPhone').textContent = lib.telefone;

            // Atualiza botão Salvar
            const btn = document.getElementById('saveBtn');
            const label = document.getElementById('saveLabel');
            if (savedLibraries.includes(lib.id)) {
                btn.classList.add('saved');
                label.textContent = 'Salvo';
            } else {
                btn.classList.remove('saved');
                label.textContent = 'Salvar';
            }

            renderUserPhotos(lib.id);
            detailPanel.classList.add('show');
        }

        function closePanel() {
            detailPanel.classList.remove('show');
        }

        // ============================================
        // 11. EVENTOS (Busca e Filtros)
        // ============================================
        searchInput.addEventListener('input', (e) => {
            currentSearch = e.target.value;
            renderList();
            renderMarkers();
        });

        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                filterButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentRegion = btn.getAttribute('data-region');
                renderList();
                renderMarkers();
            });
        });

        // ============================================
        // 12. INICIALIZAÇÃO
        // ============================================
        renderList();
        renderMarkers();
    </script>
